# =============================================================================
# InsightPM — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Frontend (Vite) ---
# Supabase project URL (e.g. https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key (safe to expose in the browser)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase project ID (used for Lovable integration)
VITE_SUPABASE_PROJECT_ID=

# --- Optional: Analytics & Error Tracking ---
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Sentry DSN for error tracking (e.g. https://xxxxx@sentry.io/xxxxx)
VITE_SENTRY_DSN=

# --- Edge Function Secrets (set via `supabase secrets set`) ---
# These are NOT prefixed with VITE_ and are never shipped to the browser.
#
# SUPABASE_URL           — same as VITE_SUPABASE_URL
# SUPABASE_ANON_KEY      — same as VITE_SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY — Supabase service role key (KEEP SECRET)
# LOVABLE_API_KEY        — Lovable AI Gateway key (Gemini models)
# FIRECRAWL_API_KEY      — Firecrawl API key for web scraping
# YOUTUBE_API_KEY        — Google YouTube Data API v3 key (optional)

# --- Optional: Industry Signals (set via `supabase secrets set`) ---
# These enable additional sources for the Industry Signals layer.
# Everything works free without them (Polymarket, Reddit, HN, GitHub, YouTube).
#
# SCRAPECREATORS_API_KEY   — ScrapeCreators key for TikTok, Instagram, Threads, X
#                            (100 free credits, then PAYG: https://scrapecreators.com)
# OPENROUTER_API_KEY       — Reserved for future Perplexity Sonar integration (not used yet)
# BRAVE_API_KEY            — Reserved for future Brave Search integration (not used yet)

# --- Database Settings for pg_cron (set via SQL) ---
# These must be configured in production Postgres for the monitoring cron job:
#   ALTER DATABASE postgres SET app.settings.supabase_url = '<your-supabase-url>';
#   ALTER DATABASE postgres SET app.settings.service_role_key = '<your-service-role-key>';
#
# Also add INTERNAL_FUNCTION_SECRET to Edge Function secrets:
# INTERNAL_FUNCTION_SECRET  — shared secret for internal function-to-function calls

# --- Stripe (Edge Function secrets via `supabase secrets set`) ---
# STRIPE_SECRET_KEY           — Stripe secret key (sk_live_... or sk_test_...)
# STRIPE_WEBHOOK_SECRET       — Webhook signing secret (whsec_...)
# STRIPE_PRICE_STARTER        — Price ID for Starter ($29/mo)
# STRIPE_PRICE_GROWTH         — Price ID for Growth ($99/mo)
# STRIPE_PRICE_ENTERPRISE     — Price ID for Enterprise ($499/mo)
# SITE_URL                    — Production URL (e.g. https://insightpm.app)
